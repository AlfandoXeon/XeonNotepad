# ============================================================
# Xeon Notepad — Environment Configuration Template
# Copy this file to .env and configure for your environment
# ============================================================

APP_NAME="Xeon Notepad"
APP_URL=http://localhost/XeonNotepad
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_NAME=xeon_notepad
DB_USER=root
DB_PASS=

# AES-256-GCM Encryption Key (64 hex chars = 32 bytes)
# Generate via: php -r "echo bin2hex(random_bytes(32));"
ENCRYPTION_KEY=
